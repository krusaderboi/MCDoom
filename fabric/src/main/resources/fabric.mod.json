{
  "schemaVersion": 1,
  "id": "doom",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "AzureDoom, Wolverbyte"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "issues": "${mod_issues}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "icon": "${mod_logo}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mod.azure.doom.FabricMCDoomMod"
    ],
    "client": [
      "mod.azure.doom.ClientListener"
    ],
    "rei_client": [
      "mod.azure.doom.rei.ReiPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "java": ">=21",
    "minecraft": "${minecraft_version}",
    "azurelib": "~${azurelib_version}",
    "accessories": "~${accessories_version}",
    "commonnetworking": "~1.0.10-1.21"
  }
}